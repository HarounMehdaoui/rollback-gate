datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN

  @@map("user_role")
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  role  Role   @default(USER)
}

model Post {
  id       Int @id @default(autoincrement())
  authorId Int
}
